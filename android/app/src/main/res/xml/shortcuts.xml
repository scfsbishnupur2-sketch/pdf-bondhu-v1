<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="open_reader"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_reader_short"
        android:shortcutLongLabel="@string/shortcut_reader_long">
        <intent
            android:action="com.nayak.pdfbondhu.ACTION_SHORTCUT"
            android:targetPackage="com.nayak.pdfbondhu"
            android:targetClass="com.nayak.pdfbondhu.MainActivity">
            <extra android:name="shortcut_tool" android:value="pdfReaderTool" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="open_planner"
        android:enabled="true"
