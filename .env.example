# ONEORA Environment Variables (Free-First Launch Mode)
# Live ads, Google Play Billing, and web payments are intentionally OFF by default.
# See MONETIZATION_CONFIG_GUIDE.md when you are ready to activate monetization later.

# Server-side Gemini API Key for ONEORA AI Assistant (/api/ai/chat)
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional public URL for SEO / sharing links
APP_URL="https://oneora.app"

# Server port (AI Studio uses 3000)
PORT=3000
